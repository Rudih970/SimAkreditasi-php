# ============================================================================
# SIM Akreditasi — Apache URL Rewriting
# ============================================================================
# Semua request diarahkan ke index.php sebagai front controller.
# Kecuali: file statis (CSS, JS, gambar) dan direktori yang ada.
# ============================================================================

# Aktifkan mod_rewrite
RewriteEngine On

# Base directory
RewriteBase /SimAkreditasi/

# Jangan rewrite jika file/direktori benar-benar ada
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Arahkan semua request ke index.php dengan URL sebagai parameter
RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]

# ============================================================================
# Security Headers
# ============================================================================

# Cegah akses ke file sensitif
<FilesMatch "\.(env|log|sql|md|gitignore)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Cegah directory listing
Options -Indexes

# Cegah akses ke file PHP di folder tertentu
<IfModule mod_rewrite.c>
    RewriteRule ^(config|core|models|logs)/ - [F,L]
</IfModule>

# ============================================================================
# Performance
# ============================================================================

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
